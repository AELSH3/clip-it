# Copy to .env and adjust. Never commit a real .env.
# Local single-user mode is the default. Do not publish port 8000 without authentication.

CLIPIT_DATABASE_URL=postgresql+psycopg://clipit:clipit@localhost:5432/clipit
CLIPIT_REDIS_URL=redis://localhost:6379/0
CLIPIT_STORAGE_DIR=./data
CLIPIT_MODEL_DIR=./models
CLIPIT_MAX_UPLOAD_BYTES=524288000
CLIPIT_MAX_DURATION_SEC=3600
CLIPIT_WINDOW_SEC=8
CLIPIT_WINDOW_STRIDE_SEC=4
CLIPIT_FRAME_SAMPLE_SEC=2
CLIPIT_WHISPER_MODEL=tiny
CLIPIT_WHISPER_DEVICE=cpu
CLIPIT_WHISPER_COMPUTE_TYPE=int8
CLIPIT_TEXT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CLIPIT_CLIP_MODEL_NAME=ViT-B-32
CLIPIT_CLIP_PRETRAINED=openai
CLIPIT_TORCH_DEVICE=auto
CLIPIT_AUTH_MODE=local
CLIPIT_API_TOKEN=
CLIPIT_PUBLIC_DEPLOYMENT=false
CLIPIT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLIPIT_INLINE_PROCESSING=false
CLIPIT_LLM_BASE_URL=
CLIPIT_LLM_API_KEY=
CLIPIT_LLM_MODEL=
CLIPIT_LOG_LEVEL=INFO
